<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#0b1f3a">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="عنوان كمبيوتر الكاشير" android:textColor="#FFFFFF" android:paddingBottom="6dp"/>
    <EditText android:id="@+id/host" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="192.168.1.20" android:textColor="#FFFFFF" android:inputType="text"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="المنفذ" android:textColor="#FFFFFF" android:paddingTop="12dp"/>
    <EditText android:id="@+id/port" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="8765" android:textColor="#FFFFFF" android:inputType="number"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="الرمز t" android:textColor="#FFFFFF" android:paddingTop="12dp"/>
    <EditText android:id="@+id/token" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="alasil" android:textColor="#FFFFFF"/>
    <Button android:id="@+id/save" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="حفظ وفتح المسح" android:layout_marginTop="20dp"/>
</LinearLayout>
